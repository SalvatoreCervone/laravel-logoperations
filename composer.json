{
    "name": "salvatorecervone/logoperations",
    "description": "Pacchetto Laravel per il tracciamento automatico delle operazioni HTTP con supporto polimorfico, gestione transazioni, stack trace a 2 livelli e interfaccia Vue 3 moderna.",
    "type": "library",
    "keywords": [
        "laravel",
        "log",
        "logging",
        "operations",
        "audit",
        "audit-log",
        "activity-log",
        "http-logger",
        "middleware",
        "stack-trace",
        "tracing",
        "transactions",
        "monitoring",
        "vue",
        "vue3",
        "dashboard",
        "viewer"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Salvatore Cervone",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SalvatoreCervone\\LogOperations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SalvatoreCervone\\LogOperations\\LogOperationsServiceProvider"
            ],
            "aliases": {
                "LogOperations": "SalvatoreCervone\\LogOperations\\Facades\\LogOperations"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
